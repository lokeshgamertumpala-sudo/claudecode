{
  "name": "orbitforge-ai",
  "version": "1.0.0",
  "description": "ORBITFORGE AI - AI-assisted interactive space mission design and engineering simulation platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
